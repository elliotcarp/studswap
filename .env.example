# --- Database ---
# Dev (SQLite): DATABASE_URL="file:./dev.db"
# Prod (Neon Postgres): DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Email provider (magic link sign-in) ---
# Any SMTP provider works; Resend/Postmark/Mailgun are simple options.
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="StudSwap <noreply@yourdomain.com>"

# --- Vercel Blob (photo storage) ---
PHOTOS_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Stripe (€25 confirmation charge) ---
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Admin (/admin: payouts owed, no-show/dispute reports, manual full-refund trigger) ---
# Comma-separated sign-in emails allowed to access /admin and /api/admin/*.
ADMIN_EMAILS="you@example.com"

# --- Anthropic (AI fallback for university email domains not in the static allow-list) ---
# Optional: without this, unlisted domains are rejected (fails closed).
ANTHROPIC_API_KEY="sk-ant-..."
